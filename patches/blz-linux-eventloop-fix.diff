+	int r, i;
+	/* Drain a bounded burst per call: sd_bus_process handles at most one
+	 * message per call and returns >0 while work remains. During active
+	 * BLE discovery BlueZ streams continuous RSSI PropertiesChanged, so an
+	 * unbounded loop would never return; cap it and let the periodic pump
+	 * / fd handler pick up the rest, keeping the Tcl event loop responsive. */
+	for (i = 0; i < 20; i++) {
+		r = sd_bus_process(ctx->bus, NULL);
+		if (r < 0) {
+			LOG_ERR("BLZ: Handle read process error: %s", strerror(-r));
+			return;
+		}
+		if (r == 0) {
+			break;
+		}
